{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BHOST Setup",
  "version": "0.1.0",
  "identifier": "fr.catgraphique.bhost.setup",
  "build": {
    "frontendDist": "../dist-setup"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Installer BHOST",
        "url": "installeur.html",
        "width": 520,
        "height": 460,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../src-tauri/icons/32x32.png",
      "../src-tauri/icons/128x128.png",
      "../src-tauri/icons/icon.ico"
    ]
  }
}
